# Text files compiled into a program, word for word: the licences the viewer's About window shows (src/viewer/about.h).
#
# knit_embed_texts(OUTPUT <file.cpp> INCLUDE <header> TEXTS <symbol> <path> [<symbol> <path> ...])
# writes one C++ file that defines `const unsigned char <symbol>[]` in namespace viewer for each path, with a 0 at the end, and
# includes <header>, which declares them extern. The bytes are written as a list of numbers rather than a string literal:
# MSVC refuses a literal over 16 KB, and the MPL-2.0 text is 16.7 KB. Unsigned, so a UTF-8 byte over 0x7f is no narrowing.
# Carriage returns are dropped, so a checkout with Windows line ends embeds the same text. The file is rewritten only when its
# content changes (file(CONFIGURE)), and a change to any source file reconfigures.
function(knit_embed_texts)
    cmake_parse_arguments(PARSE_ARGV 0 E "" "OUTPUT;INCLUDE" "TEXTS")
    list(LENGTH E_TEXTS count)
    math(EXPR odd "${count} % 2")
    if(count EQUAL 0 OR odd)
        message(FATAL_ERROR "knit_embed_texts: TEXTS takes pairs of <symbol> <path>")
    endif()
    # Sixteen bytes per line: a pattern of sixteen "0x..," groups (CMake's regular expressions have no {n}).
    set(sixteen "")
    foreach(i RANGE 1 16)
        string(APPEND sixteen "0x[0-9a-f][0-9a-f],")
    endforeach()
    set(content "// Generated by knit_embed_texts (cmake/embed_texts.cmake) from the files named below. Do not edit.\n")
    string(APPEND content "#include \"${E_INCLUDE}\"\n\nnamespace viewer {\n")
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET E_TEXTS ${i} symbol)
        list(GET E_TEXTS ${j} path)
        if(NOT EXISTS ${path})
            message(FATAL_ERROR "knit_embed_texts: ${symbol}: no file ${path}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${path})
        file(READ ${path} hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REPLACE "0x0d," "" bytes "${bytes}")
        string(REGEX REPLACE "(${sixteen})" "\\1\n    " bytes "${bytes}")
        string(APPEND content "\n// ${path}\nconst unsigned char ${symbol}[] = {\n    ${bytes}0x00};\n")
    endforeach()
    string(APPEND content "\n} // namespace viewer\n")
    file(CONFIGURE OUTPUT ${E_OUTPUT} CONTENT "${content}" @ONLY)
endfunction()
