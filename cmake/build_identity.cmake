# Run at every build (cmake -P, the target knit_build_identity in src/viewer/CMakeLists.txt): writes the commit the program
# is built from, and the CUDA Toolkit version it links, into a C++ file for the About window (src/viewer/about.h).
#
#   cmake -DSOURCE_DIR=<checkout> -DOUTPUT=<file.cpp> -DINCLUDE=<header> -DCUDA_VERSION=<x.y.z> -P build_identity.cmake
#
# The identity is `git describe --always --dirty`: the commit, with "-dirty" when the checkout had uncommitted changes; "unknown"
# without git or outside a repository. The file is rewritten only when the identity changes, so an unchanged build compiles
# nothing.
execute_process(COMMAND git describe --always --dirty
                WORKING_DIRECTORY ${SOURCE_DIR}
                OUTPUT_VARIABLE identity
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
                RESULT_VARIABLE failed)
if(failed OR identity STREQUAL "")
    set(identity "unknown")
endif()
set(content "// Generated by cmake/build_identity.cmake at build time. Do not edit.\n#include \"${INCLUDE}\"\n\nnamespace viewer {\nconst char kBuildIdentity[] = \"${identity}\";\nconst char kCudaVersion[] = \"${CUDA_VERSION}\";\n} // namespace viewer\n")
set(before "")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} before)
endif()
if(NOT before STREQUAL content)
    file(WRITE ${OUTPUT} "${content}")
endif()
