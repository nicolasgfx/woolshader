# Components: one folder of src/ = one static library whose interface the compiler enforces.
#
# knit_component() writes, for every header of the component, a two-line forwarding header into the build
# tree: build/components/<name>/public/<name>/<path> for the headers other components may include, and
# build/components/<name>/private/<name>/<path> for the ones only the component itself sees. The library
# gets the public root as a PUBLIC include directory and the private root as a PRIVATE one; src/ is on no
# include path. An include of an undeclared component, or of another component's private header, fails
# with "cannot open include file". Include spellings stay module-prefixed ("knitting/checks/checks.h").
#
# The graph lives in the calls: PUBLIC_DEPS are components a public header includes (their users see
# them too), PRIVATE_DEPS only the sources and private headers include. A dependency must be declared
# before its user, so the graph has no cycles. knit_components_finish() checks the declarations and
# writes build/components.json, which cmake/component_report.py and the architecture test read.

set(KNIT_COMPONENT_ROOT ${CMAKE_BINARY_DIR}/components)

# knit_component(<name> [TARGET <library>] SOURCES ... PUBLIC_HEADERS ... PRIVATE_HEADERS ... PUBLIC_DEPS ...
#                PRIVATE_DEPS ... PUBLIC_LIBS ... PRIVATE_LIBS ...)
# The library is knit_<name> unless TARGET names it (the viewer's state library: knit_viewer is its program).
# Paths are relative to src/<name>/ (absolute: a third-party implementation unit); *_LIBS are non-component
# targets (third-party, CUDA).
function(knit_component name)
    cmake_parse_arguments(PARSE_ARGV 1 C "" "TARGET"
        "SOURCES;PUBLIC_HEADERS;PRIVATE_HEADERS;PUBLIC_DEPS;PRIVATE_DEPS;PUBLIC_LIBS;PRIVATE_LIBS")
    set(lib knit_${name})
    if(C_TARGET)
        set(lib ${C_TARGET})
    endif()
    set(folder ${CMAKE_SOURCE_DIR}/src/${name})
    get_property(declared GLOBAL PROPERTY KNIT_COMPONENTS)
    if(name IN_LIST declared)
        message(FATAL_ERROR "knit_component(${name}): declared twice")
    endif()
    foreach(dep IN LISTS C_PUBLIC_DEPS C_PRIVATE_DEPS)
        if(NOT dep IN_LIST declared)
            message(FATAL_ERROR "knit_component(${name}): dependency '${dep}' is not a component declared before it")
        endif()
    endforeach()

    # Every header of the folder is listed exactly once, and every listed header exists.
    file(GLOB_RECURSE found RELATIVE ${folder} ${folder}/*.h ${folder}/*.cuh)
    set(listed ${C_PUBLIC_HEADERS} ${C_PRIVATE_HEADERS})
    foreach(h IN LISTS found)
        list(FIND listed ${h} at)
        if(at EQUAL -1)
            message(FATAL_ERROR "knit_component(${name}): src/${name}/${h} is in no header list")
        endif()
    endforeach()
    set(seen "")
    foreach(h IN LISTS listed)
        if(NOT EXISTS ${folder}/${h})
            message(FATAL_ERROR "knit_component(${name}): listed header src/${name}/${h} does not exist")
        endif()
        if(h IN_LIST seen)
            message(FATAL_ERROR "knit_component(${name}): src/${name}/${h} is listed twice")
        endif()
        list(APPEND seen ${h})
    endforeach()

    # The forwarders. file(CONFIGURE) rewrites a file only when its content changes, so a reconfigure
    # does not touch the mtimes Ninja compares.
    set(root ${KNIT_COMPONENT_ROOT}/${name})
    set(written "")
    foreach(vis public private)
        string(TOUPPER ${vis} VIS)
        foreach(h IN LISTS C_${VIS}_HEADERS)
            set(out ${root}/${vis}/${name}/${h})
            file(CONFIGURE OUTPUT ${out} @ONLY CONTENT
                "// generated by knit_component (cmake/components.cmake): edit src/${name}/${h}\n#include \"${folder}/${h}\"\n")
            list(APPEND written ${out})
        endforeach()
    endforeach()
    # A header removed from a list, or moved from public to private, must not keep its old forwarder.
    file(GLOB_RECURSE existing LIST_DIRECTORIES false ${root}/*)
    foreach(f IN LISTS existing)
        if(NOT f IN_LIST written)
            file(REMOVE ${f})
        endif()
    endforeach()
    file(MAKE_DIRECTORY ${root}/public ${root}/private)

    set(sources "")
    foreach(f IN LISTS C_SOURCES)
        if(IS_ABSOLUTE ${f})
            list(APPEND sources ${f})  # a third-party implementation unit compiled into this component
        else()
            list(APPEND sources ${folder}/${f})
        endif()
    endforeach()
    add_library(${lib} STATIC ${sources})
    target_include_directories(${lib} PUBLIC ${root}/public PRIVATE ${root}/private)
    foreach(dep IN LISTS C_PUBLIC_DEPS)
        get_property(dep_lib GLOBAL PROPERTY KNIT_COMPONENT_${dep}_TARGET)
        target_link_libraries(${lib} PUBLIC ${dep_lib})
    endforeach()
    foreach(dep IN LISTS C_PRIVATE_DEPS)
        get_property(dep_lib GLOBAL PROPERTY KNIT_COMPONENT_${dep}_TARGET)
        target_link_libraries(${lib} PRIVATE ${dep_lib})
    endforeach()
    target_link_libraries(${lib} PUBLIC ${C_PUBLIC_LIBS} PRIVATE ${C_PRIVATE_LIBS})
    set_target_properties(${lib} PROPERTIES CXX_SCAN_FOR_MODULES OFF)
    knit_warnings(${lib})

    # One translation unit per public header, compiled as a consumer sees it: catches a public header that
    # does not compile on its own, includes a private header or uses an undeclared dependency.
    set(checks "")
    foreach(h IN LISTS C_PUBLIC_HEADERS)
        string(MAKE_C_IDENTIFIER ${h} id)
        set(tu ${CMAKE_BINARY_DIR}/header_check/${name}/${id}.cpp)
        file(CONFIGURE OUTPUT ${tu} @ONLY CONTENT "#include \"${name}/${h}\"\n")
        list(APPEND checks ${tu})
    endforeach()
    if(checks)
        add_library(knit_${name}_header_check OBJECT EXCLUDE_FROM_ALL ${checks})
        target_link_libraries(knit_${name}_header_check PRIVATE ${lib})
        set_target_properties(knit_${name}_header_check PROPERTIES CXX_SCAN_FOR_MODULES OFF)
        set_property(GLOBAL APPEND PROPERTY KNIT_HEADER_CHECKS knit_${name}_header_check)
    endif()

    set_property(GLOBAL APPEND PROPERTY KNIT_COMPONENTS ${name})
    set_property(GLOBAL PROPERTY KNIT_COMPONENT_${name}_TARGET ${lib})
    set_property(GLOBAL PROPERTY KNIT_COMPONENT_${name}_PUBLIC_HEADERS ${C_PUBLIC_HEADERS})
    set_property(GLOBAL PROPERTY KNIT_COMPONENT_${name}_PRIVATE_HEADERS ${C_PRIVATE_HEADERS})
    set_property(GLOBAL PROPERTY KNIT_COMPONENT_${name}_PUBLIC_DEPS ${C_PUBLIC_DEPS})
    set_property(GLOBAL PROPERTY KNIT_COMPONENT_${name}_PRIVATE_DEPS ${C_PRIVATE_DEPS})
endfunction()

# A program or test target of a component sees what the component's own sources see: its private headers
# and its private dependencies. One component per target, so a test program never reaches into two
# components' internals.
function(knit_component_private_access target name)
    get_target_property(granted ${target} KNIT_PRIVATE_ACCESS)
    if(granted)
        message(FATAL_ERROR "${target} already has the private headers of '${granted}', not also of '${name}'")
    endif()
    set_target_properties(${target} PROPERTIES KNIT_PRIVATE_ACCESS ${name})
    target_include_directories(${target} PRIVATE ${KNIT_COMPONENT_ROOT}/${name}/private)
    get_property(lib GLOBAL PROPERTY KNIT_COMPONENT_${name}_TARGET)
    target_link_libraries(${target} PRIVATE ${lib})
    get_property(deps GLOBAL PROPERTY KNIT_COMPONENT_${name}_PRIVATE_DEPS)
    foreach(dep IN LISTS deps)
        get_property(dep_lib GLOBAL PROPERTY KNIT_COMPONENT_${dep}_TARGET)
        target_link_libraries(${target} PRIVATE ${dep_lib})
    endforeach()
endfunction()

# The one integration test program: it runs the workflow end to end and inspects the internals of several
# components on the way, each named here. Every other test target has knit_component_private_access.
function(knit_integration_test_access target)
    get_target_property(granted ${target} KNIT_PRIVATE_ACCESS)
    if(granted)
        message(FATAL_ERROR "${target} already has the private headers of '${granted}'")
    endif()
    set_target_properties(${target} PROPERTIES KNIT_PRIVATE_ACCESS "integration: ${ARGN}")
    foreach(name IN LISTS ARGN)
        target_include_directories(${target} PRIVATE ${KNIT_COMPONENT_ROOT}/${name}/private)
        get_property(lib GLOBAL PROPERTY KNIT_COMPONENT_${name}_TARGET)
        target_link_libraries(${target} PRIVATE ${lib})
        get_property(deps GLOBAL PROPERTY KNIT_COMPONENT_${name}_PRIVATE_DEPS)
        foreach(dep IN LISTS deps)
            get_property(dep_lib GLOBAL PROPERTY KNIT_COMPONENT_${dep}_TARGET)
            target_link_libraries(${target} PRIVATE ${dep_lib})
        endforeach()
    endforeach()
endfunction()

# knit_program(<target> FOLDER <folder> SOURCES ... DEPS ... [PRIVATE_ACCESS <component>])
# A folder of src/ that holds programs and no library (src/cli): the executable sees the public headers of
# DEPS and, with PRIVATE_ACCESS, one component's private headers (a named exception). It has no headers
# of its own, and components.json lists the folder like a component, with the union of its programs'
# dependencies, so the graph check covers it too.
function(knit_program target)
    cmake_parse_arguments(PARSE_ARGV 1 P "" "FOLDER;PRIVATE_ACCESS" "SOURCES;DEPS")
    get_property(declared GLOBAL PROPERTY KNIT_COMPONENTS)
    set(sources "")
    foreach(f IN LISTS P_SOURCES)
        list(APPEND sources ${CMAKE_SOURCE_DIR}/src/${P_FOLDER}/${f})
    endforeach()
    add_executable(${target} ${sources})
    foreach(dep IN LISTS P_DEPS)
        if(NOT dep IN_LIST declared)
            message(FATAL_ERROR "knit_program(${target}): dependency '${dep}' is not a component declared before it")
        endif()
        get_property(dep_lib GLOBAL PROPERTY KNIT_COMPONENT_${dep}_TARGET)
        target_link_libraries(${target} PRIVATE ${dep_lib})
    endforeach()
    set(deps ${P_DEPS})
    if(P_PRIVATE_ACCESS)
        knit_component_private_access(${target} ${P_PRIVATE_ACCESS})
        list(APPEND deps ${P_PRIVATE_ACCESS})
    endif()
    set_target_properties(${target} PROPERTIES CXX_SCAN_FOR_MODULES OFF)
    knit_warnings(${target})
    if(NOT P_FOLDER IN_LIST declared)
        set_property(GLOBAL APPEND PROPERTY KNIT_COMPONENTS ${P_FOLDER})
        set_property(GLOBAL PROPERTY KNIT_COMPONENT_${P_FOLDER}_TARGET ${target})
    endif()
    get_property(folder_deps GLOBAL PROPERTY KNIT_COMPONENT_${P_FOLDER}_PRIVATE_DEPS)
    list(APPEND folder_deps ${deps})
    list(REMOVE_DUPLICATES folder_deps)
    set_property(GLOBAL PROPERTY KNIT_COMPONENT_${P_FOLDER}_PRIVATE_DEPS ${folder_deps})
endfunction()

# After all components: removes forwarders of components no longer declared, refuses header paths that
# would shadow another component's header (a quoted include searches the including file's folder first:
# src/scene/fibres/x.cpp including "fibres/y.h" would find src/scene/fibres/fibres/y.h before the
# forwarder), writes components.json and the knit_header_checks target.
function(knit_components_finish)
    get_property(components GLOBAL PROPERTY KNIT_COMPONENTS)

    file(GLOB folders LIST_DIRECTORIES true RELATIVE ${KNIT_COMPONENT_ROOT} ${KNIT_COMPONENT_ROOT}/*)
    foreach(f IN LISTS folders)
        if(NOT f IN_LIST components)
            file(REMOVE_RECURSE ${KNIT_COMPONENT_ROOT}/${f})
        endif()
    endforeach()

    set(spellings "")
    foreach(c IN LISTS components)
        get_property(pub GLOBAL PROPERTY KNIT_COMPONENT_${c}_PUBLIC_HEADERS)
        get_property(priv GLOBAL PROPERTY KNIT_COMPONENT_${c}_PRIVATE_HEADERS)
        foreach(h IN LISTS pub priv)
            list(APPEND spellings ${c}/${h})
        endforeach()
    endforeach()
    file(GLOB_RECURSE everything RELATIVE ${CMAKE_SOURCE_DIR}
         ${CMAKE_SOURCE_DIR}/src/*.h ${CMAKE_SOURCE_DIR}/src/*.cuh ${CMAKE_SOURCE_DIR}/tests/*.h)
    foreach(path IN LISTS everything)
        # every tail of the path after its first two folders ("src/<c>/..." or "tests/...")
        string(REPLACE "/" ";" parts ${path})
        list(LENGTH parts n)
        math(EXPR last "${n} - 2")
        if(last LESS 2)
            continue()
        endif()
        foreach(i RANGE 2 ${last})
            list(SUBLIST parts ${i} -1 tail)
            list(JOIN tail "/" spelled)
            if(spelled IN_LIST spellings AND NOT path STREQUAL "src/${spelled}")
                message(FATAL_ERROR "${path} shadows the header \"${spelled}\" for the files beside it: rename its folder")
            endif()
        endforeach()
    endforeach()

    set(json "{\n  \"source_dir\": \"${CMAKE_SOURCE_DIR}\",\n  \"component_root\": \"${KNIT_COMPONENT_ROOT}\",\n  \"components\": [")
    set(sep "")
    foreach(c IN LISTS components)
        get_property(lib GLOBAL PROPERTY KNIT_COMPONENT_${c}_TARGET)
        string(APPEND json "${sep}\n    {\"name\": \"${c}\", \"target\": \"${lib}\"")
        foreach(key PUBLIC_DEPS PRIVATE_DEPS PUBLIC_HEADERS PRIVATE_HEADERS)
            get_property(values GLOBAL PROPERTY KNIT_COMPONENT_${c}_${key})
            string(TOLOWER ${key} k)
            set(items "")
            foreach(v IN LISTS values)
                list(APPEND items "\"${v}\"")
            endforeach()
            list(JOIN items ", " joined)
            string(APPEND json ",\n     \"${k}\": [${joined}]")
        endforeach()
        string(APPEND json "}")
        set(sep ",")
    endforeach()
    string(APPEND json "\n  ]\n}\n")
    file(CONFIGURE OUTPUT ${CMAKE_BINARY_DIR}/components.json @ONLY CONTENT "${json}")

    get_property(checks GLOBAL PROPERTY KNIT_HEADER_CHECKS)
    if(checks)
        add_custom_target(knit_header_checks DEPENDS ${checks})
    endif()
endfunction()
