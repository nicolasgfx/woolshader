knit-preset v1
# Wool density preset "Light" (knit_viewer: step 2 Fibres, Fibre setup, "Density").
#
# How many fibre candidates grow per millimetre of yarn; some are rejected (inside the object,
# colliding), so fewer remain. Edit the value and restart the viewer; copy the file (new name and id)
# to add a preset. The lowest `order` comes first in the list. Bounds: 1..300 per mm.
# New objects use 125 (the settings' default), whatever this file says. The segment budget (Export
# detail level) may drop whole fibres at high densities.
id = light
label = Light
order = 1
note = 30 candidates per mm, a quarter of Dense: quick looks, the yarn shows through.

fibres.density = 30
