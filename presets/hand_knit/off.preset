knit-preset v1
# Hand-knit preset "Off" (knit_viewer: step 1 Knit, Hand-made look).
#
# How unevenly the stitches are knitted. Edit the values and restart the viewer; copy the file (new
# name and id) to add a preset. The lowest `order` comes first in the list.
id = off
label = Off
order = 1
note = The template: every stitch alike.
knit.hand.unevenness = 0
knit.hand.column_shift = 0
knit.hand.column_rows = 6
knit.hand.loop_rate = 0
knit.hand.loop_height = 0
knit.hand.wave_height = 0
knit.hand.spot_rate = 0
knit.hand.spot_change = 0
knit.hand.spot_length = 12
