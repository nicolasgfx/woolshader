knit-preset v1
# Hand-knit preset "Natural" (knit_viewer: step 1 Knit, Hand-made look).
#
# How unevenly the stitches are knitted. Edit the values and restart the viewer; copy the file (new
# name and id) to add a preset. The lowest `order` comes first in the list.
id = natural
label = Natural
order = 2
note = A careful knitter: small differences, seen up close.
knit.hand.unevenness = 10
knit.hand.column_shift = 0.35
knit.hand.column_rows = 8
knit.hand.loop_rate = 0.1
knit.hand.loop_height = 0.5
knit.hand.wave_height = 0.12
knit.hand.spot_rate = 0.15
knit.hand.spot_change = 15
knit.hand.spot_length = 10
