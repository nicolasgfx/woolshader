knit-preset v1
# Fibre island preset "Worn" (knit_viewer: step 2 Fibres, Fibre islands).
#
# Patches where the fuzz differs from the even fuzz around them. Edit the values and restart the
# viewer; copy the file (new name and id) to add a preset. The lowest `order` comes first in the list.
id = worn
label = Worn
order = 3
note = Worn in: fuzzy and flattened patches.
fibres.islands.rate = 0.15
fibres.islands.size = 14
fibres.islands.strength = 70
fibres.islands.fuzzy = 1
fibres.islands.matted = 2
fibres.islands.worn = 1
